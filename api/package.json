    "express-rate-limit": "^8.1.0",
    "@google/genai": "^1.30.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^7.17.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "@types/node": "^20.19.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0"
  }
